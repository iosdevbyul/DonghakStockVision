# Approved KRX key; request approval for each market API. Never commit the actual key.
KRX_API_KEY=
DSV_DB_PATH=.data/market.sqlite3
# One of KOSPI, KOSDAQ, KONEX; collect each market separately.
DSV_KRX_MARKET=KOSPI
# Local safety limits: minimum 1 second, maximum 9500 requests per Seoul day.
DSV_REQUEST_INTERVAL=1.0
DSV_DAILY_REQUEST_LIMIT=9500
